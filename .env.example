# ---- database (PostgreSQL only) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agent_chat"

# ---- app ----
FRONTEND_ORIGIN="http://localhost:3000"
PUBLIC_API_BASE_URL="http://localhost:3001"
LOG_LEVEL="info"

# ---- auth (Clerk; same instance as the frontend) ----
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
# optional: PEM public key for networkless JWT verification
# CLERK_JWT_KEY=""

# ---- LLM (OpenRouter FREE router only; no paid fallback) ----
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openrouter/free"

# ---- Magica (required tools: crop_image, gpt_image_2, merge_videos) ----
MAGICA_API_KEY="..."
MAGICA_BASE_URL="https://inference.magica.com"
# MAGICA_WEBHOOK_SECRET="whsec_..."   # svix signing secret if inbound run webhooks are enabled

# ---- Trigger.dev ----
TRIGGER_SECRET_KEY="tr_dev_..."
TRIGGER_PROJECT_REF="proj_..."

# ---- Transloadit (Community plan) ----
TRANSLOADIT_KEY="..."
TRANSLOADIT_SECRET="..."
# TRANSLOADIT_TEMPLATE_ID=""            # optional; inline steps are used when unset
# TRANSLOADIT_STORE_CREDENTIALS=""      # optional Template Credentials name for /s3/store (e.g. Cloudflare R2)

# ---- S3-compatible media storage (optional; RUNBOOK §9c) ----
# S3_BUCKET=""                          # e.g. agent-chat-media-xxxxxxxx; unset keeps provider URLs (24h expiry)
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""                  # IAM user scoped to the bucket
# AWS_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""                 # optional CDN/custom domain in front of the bucket

# ---- credits (microcredits; 1 credit = 1,000,000) ----
SIGNUP_GRANT_MICROCREDITS=100000000
ADMISSION_MICROCREDITS=10000
APPROVAL_THRESHOLD_MICROCREDITS=50000

# ---- outbound webhooks ----
# WEBHOOK_SIGNING_SECRET=""
